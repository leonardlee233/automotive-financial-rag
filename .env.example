# Local default: no API key needed. Start llama-server before querying.
ANSWER_BACKEND=local
LOCAL_LLM_URL=http://127.0.0.1:8081/v1/chat/completions
# Optional remote mode: set ANSWER_BACKEND=openai and supply key in process environment.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini

# Default course embedding. The first run downloads the model from Hugging Face.
EMBEDDING_MODEL=Qwen/Qwen3-Embedding-0.6B

